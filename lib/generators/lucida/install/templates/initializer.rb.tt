# frozen_string_literal: true

Lucida::Rails.configure do |c|
  c.api_key = ENV["LUCIDA_API_KEY"]
  c.host = ENV.fetch("LUCIDA_HOST", "https://app.lucida.dev")
  c.secret_key = ENV["LUCIDA_SECRET_KEY"] # enables local flag evaluation (polled in the background)

  # Adopt X-Lucida-Distinct-Id / X-Lucida-Session-Id sent by the browser SDK (client-controlled: never use for auth).
  c.use_tracing_headers = true
  # Use the signed-in user as the distinct id: current_user.id
  c.capture_user_context = true
  c.current_user_method = :current_user
  c.user_id_method = :id
  # c.trust_proxy = true # take $ip from X-Forwarded-For when behind a trusted proxy

  # Anything Lucida::Client accepts, e.g. { on_error: ->(e) { Rails.logger.warn(e.message) }, flush_interval: 5 }
  c.client_options = {}
end
